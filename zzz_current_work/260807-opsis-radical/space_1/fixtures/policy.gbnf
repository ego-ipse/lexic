# The instrument's own state, as a text it can read.
#
# Every presentation gesture lands here as a line, so the session's own
# arrangement is a document like any other — with spans, a spine and a
# verdict. Saving a valid record APPLIES it: the ring closes.
record ::= line*
line ::= key sp value nl | nl
key ::= kchar+
sp ::= " "
value ::= vchar*
nl ::= "\n"
kchar ::= [a-z0-9._-]
vchar ::= [\x20-\U0010ffff]
