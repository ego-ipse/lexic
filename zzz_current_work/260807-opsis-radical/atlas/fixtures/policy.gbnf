# opsis's own state — the session policy record as a readable, editable text.
# Saving a valid record APPLIES it: the session rearranges. The ring.
record ::= line*
line ::= key sp value nl | nl
key ::= kchar+
sp ::= " "
value ::= vchar*
nl ::= "\n"
kchar ::= [a-z0-9._-]
vchar ::= [\x20-\U0010ffff]
