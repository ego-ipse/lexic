# Many rules, shallow — for looking at width.
#
# The rules graph lays these out by distance from the start, so the
# columns ARE the depth. The railroad stacks all of them.
root ::= item (sep item)*
sep ::= "," ws
item ::= word | number | quoted | flag | pair
pair ::= word "=" value
value ::= word | number | quoted
quoted ::= "\"" inner "\"" 
inner ::= [^"]*
flag ::= "+" word | "-" word
word ::= alpha alnum*
alpha ::= [a-zA-Z_]
alnum ::= [a-zA-Z0-9_]
number ::= sign? digits frac?
sign ::= "-"
digits ::= [0-9]+
frac ::= "." digits
ws ::= [ \t]*
# @non-semantic ws
